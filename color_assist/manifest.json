{
  "manifest_version": 3,
  "name": "맞춤형 색각보정 시스템",
  "version": "0.3.2",
  "description": "색 구별 테스트 결과를 바탕으로 웹 UI와 이미지 내부의 혼동 가능 색상 영역만 선택적으로 보정합니다.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "맞춤형 색각보정 시스템"
  },
  "options_page": "test.html",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}